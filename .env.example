# Copy to .env for local dev. NEVER commit the real .env.
ENV=development
DEBUG=true

# Local Postgres (docker-compose provides this)
DATABASE_URL=postgresql+asyncpg://mandi:mandi@localhost:5432/mandi

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allow-list. No wildcards with credentials.
CORS_ORIGINS=http://localhost:5173

# Cookies: set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Seeding (used once)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=change-this-min-12-chars
